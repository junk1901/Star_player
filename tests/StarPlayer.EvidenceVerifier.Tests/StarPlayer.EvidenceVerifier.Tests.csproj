<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- G4: this assembly also runs as its own process (G4ChildProgram.Main) to isolate loads that cannot be undone inside the shared test host -->
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\StarPlayer.EvidenceVerifier\StarPlayer.EvidenceVerifier.csproj" />
    <!-- the TEST_ONLY seed / world builders of the harness tests are reused, not copied -->
    <ProjectReference Include="..\StarPlayer.SimHarness.Tests\StarPlayer.SimHarness.Tests.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>