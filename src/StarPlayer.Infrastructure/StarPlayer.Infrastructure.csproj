<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <ProjectReference Include="..\StarPlayer.Application\StarPlayer.Application.csproj" />
    <ProjectReference Include="..\StarPlayer.Domain\StarPlayer.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fictional Phase 1 pack, embedded so the exported desktop build needs no loose content folder. -->
    <EmbeddedResource Include="..\..\content\fictional\phase1_two_club_pack.json" LogicalName="phase1_two_club_pack.json" />
    <!-- Phase 2: GameRules profiles (KBO-oriented unverified + fictional test variants) and the fictional diagnostic games. -->
    <EmbeddedResource Include="..\..\content\rules\game_rules_profiles.json" LogicalName="game_rules_profiles.json" />
    <EmbeddedResource Include="..\..\content\fictional\phase2_diagnostic_games.json" LogicalName="phase2_diagnostic_games.json" />
    <!-- Phase 3-B1: gamerules-v2 profiles (called-pitch mode + Pitch Zone Lite zone model); fictional test variants only. -->
    <EmbeddedResource Include="..\..\content\rules\game_rules_profiles_v2.json" LogicalName="game_rules_profiles_v2.json" />
    <!-- Phase 3-B2: virtual prototype tuning data for the conditional probability model (prob-model-v1). -->
    <EmbeddedResource Include="..\..\content\tuning\virtual_tuning_v1.json" LogicalName="virtual_tuning_v1.json" />
    <!-- Phase 3-D: tuning-virtual-proto-v2 for prob-model-v2 (the three park slots active); v1 above is never edited. -->
    <EmbeddedResource Include="..\..\content\tuning\virtual_tuning_v2.json" LogicalName="virtual_tuning_v2.json" />
    <!-- Phase 3-E: tuning-virtual-proto-v3 for prob-model-v3 (catcher.framing active); v1 and v2 above are never edited. -->
    <EmbeddedResource Include="..\..\content\tuning\virtual_tuning_v3.json" LogicalName="virtual_tuning_v3.json" />
    <!-- Phase 3-E: tuning-virtual-proto-v4 for prob-model-v4 (catcher.game_calling active); v1, v2 and v3 above are never edited. -->
    <EmbeddedResource Include="..\..\content\tuning\virtual_tuning_v4.json" LogicalName="virtual_tuning_v4.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Raw fixture/world types are internal; only these test assemblies may see them (the Godot client may not). -->
    <InternalsVisibleTo Include="StarPlayer.Application.Tests" />
    <InternalsVisibleTo Include="StarPlayer.Infrastructure.Tests" />
  </ItemGroup>
</Project>
